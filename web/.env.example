# Public address of the site, used in links inside e-mails
SITE_URL=http://localhost:3000

# PostgreSQL connection. Leave empty in development to use the embedded database in .data/pglite
DATABASE_URL=

# Where new contact form submissions and support tickets are reported
NOTIFY_EMAIL=destek@gotech.local
MAIL_FROM="GoTech <bildirim@gotech.local>"

# SMTP. Leave SMTP_HOST empty to keep mail in test mode (nothing is sent, mails appear under /yonetim/mailler)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# GoTech Desk (remote support). Key that encrypts stored unattended-access passwords: base64 of 32 random bytes.
# Generate with: openssl rand -base64 32   (required in production; development falls back to a fixed key)
DESK_SECRET_KEY=
# Rendezvous server the desktop app connects to; used to check which computers are online
DESK_SERVER_HOST=152.53.142.222
DESK_SERVER_NAT_PORT=21115
# Installer download links shown in the customer panel. Leave empty to hide a button.
DESK_DOWNLOAD_WINDOWS_URL=
DESK_DOWNLOAD_MAC_URL=
