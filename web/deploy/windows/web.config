<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS sitesinin fiziksel klasörüne (ör. C:\gotech\iis) bu dosya konur.
  IIS hiçbir dosya sunmaz; gelen bütün istekleri 127.0.0.1:3000'de çalışan
  Next.js sürecine aktarır. Gereken IIS eklentileri: URL Rewrite 2.1 + ARR 3.0.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="GoTech Next.js" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
          <serverVariables>
            <!-- Uygulama linkleri https üretsin diye; ARR'de "Allowed Server Variables"a eklenmeli -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Destek talebine eklenen dosya 250 MB'a kadar olabiliyor -->
        <requestLimits maxAllowedContentLength="262144000" />
      </requestFiltering>
    </security>

    <!-- Uygulamanın kendi 404/500 sayfaları görünsün, IIS'inkiler değil -->
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
