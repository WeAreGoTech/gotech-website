# C:\gotech\web\.env olarak kaydedin. Değerleri kendi sunucunuza göre doldurun.

NODE_ENV=production

# Sitenin dışarıdan görünen adresi. Maillerdeki linkler bundan üretilir.
SITE_URL=https://gotech.com.tr

# Windows'a kurulan PostgreSQL. Şifreyi kurulumda belirlediğinizle değiştirin.
DATABASE_URL=postgresql://gotech:BURAYA_SIFRE@127.0.0.1:5432/gotech

# Destek taleplerine eklenen dosyalar. Bu klasör yedeklenmeli.
UPLOAD_DIR=C:\gotech\data\uploads

# Yeni başvuru ve destek talebi bildirimlerinin gideceği adres
NOTIFY_EMAIL=destek@gotech.com.tr
MAIL_FROM="GoTech <bildirim@gotech.com.tr>"

# SMTP boş kalırsa mail gönderilmez, sadece /yonetim/mailler altında listelenir.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Uzak destek (GoTech Desk). Kayıtlı şifreleri şifreleyen anahtar; üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Bir kez üretilir ve BİR DAHA DEĞİŞTİRİLMEZ: değişirse kayıtlı erişim şifreleri okunamaz.
DESK_SECRET_KEY=

# RustDesk buluşma sunucusu. Şu an bu sunucu 152.53.142.222'de çalışıyor.
DESK_SERVER_HOST=152.53.142.222
DESK_SERVER_NAT_PORT=21115
